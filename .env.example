# Copiar a .env (raíz) y a apps/api/.env según corresponda. Nunca subir .env al repo.

# --- Base de datos y caché ---
DATABASE_URL=postgresql://parkgt:parkgt@localhost:5432/parkgt?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3001
# dev | firebase. En dev, "Authorization: Bearer dev:<userId>:<platformRole>" autentica sin Firebase.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Clave ES256 (PEM, base64) para firmar los pases QR. Generar con: pnpm --filter @parkgt/api keys:generate
PASS_SIGNING_PRIVATE_KEY_PEM_BASE64=
PASS_SIGNING_PUBLIC_KEY_PEM_BASE64=
# Clave simétrica (32 bytes base64) para cifrar datos sensibles en reposo (cuentas bancarias, credenciales FEL).
DATA_ENCRYPTION_KEY_BASE64=

# --- Pagos ---
# mock | recurrente | tilopay
PAYMENT_PROVIDER=mock
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=

# --- Facturación FEL ---
# mock | infile | digifact
INVOICE_PROVIDER=mock
INFILE_USUARIO=
INFILE_LLAVE_FIRMA=
INFILE_LLAVE_API=
PLATFORM_NIT=
PLATFORM_LEGAL_NAME=

# --- Notificaciones ---
# console | whatsapp
NOTIFIER_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mapas (apps móviles y web) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Observabilidad ---
SENTRY_DSN=
POSTHOG_KEY=
